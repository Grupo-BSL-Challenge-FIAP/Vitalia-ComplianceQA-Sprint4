              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));\r\nconst corpo = pm.response.json();\r\npm.test(\"Mensagem de data obrigatória\", () => pm.expect(corpo.messages.appointmentDate).to.eql(\"A data da consulta é obrigatória\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
