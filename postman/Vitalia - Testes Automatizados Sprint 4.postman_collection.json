  "item": [
    {
      "name": "01 - Login válido",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\nconst json = pm.response.json();\r\npm.test(\"Retorna token JWT com 3 partes\", () => {\r\n  pm.expect(json.token).to.be.a(\"string\");\r\n  pm.expect(json.token.split(\".\")).to.have.lengthOf(3);\r\n  pm.environment.set(\"token\", json.token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\":\"{{email}}\",\r\n    \"password\":\"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Rota protegida sem token",
      "item": [
        {
          "name": "perfil sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sem token é barrado\", () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Perfil do tutor autenticado",
      "item": [
        {
          "name": "perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\nconst me = pm.response.json();\r\npm.test(\"E-mail do tutor autenticado\", () => pm.expect(me.email).to.eql(pm.environment.get(\"email\")));\r\npm.test(\"Perfil TUTOR\", () => pm.expect(me.roles.map(r => r.name || r)).to.include(\"TUTOR\"));\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Pets do tutor autenticado",
      "item": [
        {
          "name": "meus pets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
                  "const pets = pm.response.json().content;\r",
                  "const nomes = pets.map(p => p.name);\r",
                  "pm.test(\"Contém Lola\", () => pm.expect(nomes).to.include(\"Lola\"));\r",
                  "pm.test(\"Não contém Rex\", () => pm.expect(nomes).to.not.include(\"Rex\"));\r",
                  "pm.environment.set(\"petId\", pets.find(p => p.name === \"Lola\").id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/my-pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "my-pets"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Consulta sem data é rejeitada",
      "item": [
